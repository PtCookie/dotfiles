# This is Git's per-user configuration file.
[user]
	name = Minsup Ju
	email = me@ptcookie.net
	signingkey = 0xFC175D3C1D1A6B6C
[core]
	eol = lf
	autocrlf = input
	symlinks = true
	fscache = true
	excludesfile = ~/.config/git/ignore
	editor = vim
	pager = delta
[alias]
	ss = status --short
	dc = diff --cached
	ds = diff --stat
	ll = log --oneline
	lg = log --oneline --graph --date-order --all
	ls = log --pretty=short --show-signature
	change = !git log --oneline --no-decorate --no-merges $(git describe --tags --abbrev=0)..HEAD
	unstage = reset HEAD --
[commit]
	gpgsign = true
	template = ~/.config/git/template
[tag]
	gpgSign = true
[diff]
	colorMoved = default
[diff "astextplain"]
	textconv = astextplain
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	program = gpg
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictstyle = diff3
[pull]
	rebase = false

[delta]
	features = side-by-side decoration
	syntax-theme = base16
	navigate = true
	light = false
[delta "side-by-side"]
	side-by-side = true
[delta "decoration"]
	line-numbers = true
	file-style = bold green ul
	hunk-header-decoration-style = box
