# This is Git's per-user configuration file.
[user]
    name = Minsup Ju
    email = dev@ptcookie.dev
    signingkey = 0xCE5C6CCB44A64621
[core]
    eol = lf
    autocrlf = input
    symlinks = true
    fscache = true
    excludesfile = ~/.config/git/ignore
    editor = vim
    pager = delta
[alias]
    ss = status -s
    dc = diff --cached
    ll = log --oneline --all
    ls = log --pretty=short --show-signature
    lg = log --pretty=short --graph --all
    unstage = reset HEAD --
[commit]
    gpgsign = true
    template = ~/.config/git/template
[diff]
    colorMoved = default
[diff "astextplain"]
    textconv = astextplain
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[gpg]
    program = gpg
[init]
    defaultBranch = main
[interactive]
    diffFilter = delta --color-only
[merge]
    conflictstyle = diff3
[pull]
    rebase = false

[delta]
    features = side-by-side decoration
    syntax-theme = base16
    navigate = true
    light = false
[delta "side-by-side"]
    side-by-side = true
[delta "decoration"]
    line-numbers = true
    file-style = bold green ul
    hunk-header-decoration-style = box
