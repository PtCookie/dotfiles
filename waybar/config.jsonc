{
    "layer": "top",
    "position": "top",
    "spacing": 4,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "mpris"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "disk",
        "network",
        "tray",
        "wireplumber",
        "clock"
    ],
    "custom/launcher": {
        "format": " ",
        "tooltip": false,
        "on-click": "wofi --show drun",
        "on-click-right": "killall wofi"
    },
    "hyprland/workspaces": {
        "format": "{name} {windows}",
        "persistent-workspaces": {
            "*": 2
        },
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<Alacritty>": "",
            "class<com.mitchellh.ghostty>": "",
            "class<pcmanfm-qt>": "",
            "title<ranger>": "",
            "class<zathura>": "",
            "class<imv>": "",
            "class<mpv>": "",
            "class<zen>": "󰈹",
            "class<org.mozilla.Thunderbird>": "",
            "class<org.telegram.desktop>": "",
            "class<com.discordapp.Discord>": "",
            "class<Spotify>": "",
            "class<codium>": "",
            "class<firefox-dev>": "󰈹",
            "class<Io.github.ungoogled_software.ungoogled_chromium>": ""
        },
        "all-outputs": true,
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "hyprland/window": {
        "format": "{}",
        "rewrite": {
            "ranger (.*)": " $1",
            "imv - (.*)": " $1",
            "(.*) - mpv": " $1",
            "vim (.*)": " $1",
            "(.*) — Zen Browser": "󰈹  $1",
            "(.*) - Mozilla Thunderbird": "  $1",
            "(.*) - Discord": "  $1",
            "(.*) - VSCodium": "  $1",
            "(.*) — Firefox Developer Edition": "󰈹  $1",
            "(.*) - Chromium": " $1"
        },
        "separate-outputs": true
    },
    "cpu": {
        "format": " {usage}%"
    },
    "memory": {
        "format": " {used:0.2f}GiB",
        "tooltip-format": "Mem {percentage}% of {total:0.2f}GiB\nSwap {swapPercentage}% of {swapTotal:0.2f}GiB"
    },
    "disk": {
        "format": " {percentage_used}%"
    },
    "network": {
        "interval": 5,
        "format": " {bandwidthDownBytes}  {bandwidthUpBytes}",
        "format-disconnected": " Disconnected",
        "tooltip-format": " {ifname}: {ipaddr}/{cidr}",
        "tooltip-wifi": " {essid} ({signalStrength}%)",
        "tooltip-format-disconnected": " Disconnected"
    },
    "tray": {
        "icon-size": 20,
        "spacing": 10,
        "show-passive-items": true,
        "reverse-direction": true
    },
    // "keyboard-state": {
    //   "numlock": false,
    //   "capslock": true,
    //   "format": "{icon} {name}",
    //   "format-icons": {
    //     "locked": "",
    //     "unlocked": ""
    //   }
    // },
    "wireplumber": {
        "format": "{icon}  {volume}%",
        "format-muted": " {volume}%",
        "format-icons": [
            "",
            "",
            ""
        ],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 2.0
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "interval": 1,
        "on-click": "playerctl previous",
        "on-click-middle": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "dynamic-order": [
            "title",
            "artist",
            "position",
            "length"
        ],
        "player-icons": {
            "default": "▶",
            "elisa": "",
            "spotify": "",
            "mpv": ""
        },
        "status-icons": {
            "paused": "⏸"
        }
    },
    "clock": {
        "format": " {:%H:%M %a}",
        "format-alt": " {:%Y-%m-%d %H:%M}",
        "tooltip-format": "<small>{calendar}</small>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "on-scroll": -1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
