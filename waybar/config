{
    "layer": "top",
    "position": "top",
    "spacing": 4,
    "modules-left": ["custom/launcher", "cpu", "memory", "temperature", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["tray", "custom/ibus", "keyboard-state", "network", "wireplumber", "clock"],
    "custom/launcher": {
        "format": "",
        "on-click": "wofi --show drun",
        "on-click-right": "killall wofi"
    },
    "cpu": {
        "format": " {usage}%"
    },
    "memory": {
        "format": " {}%"
    },
    "temperature": {
        "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon0/temp1_input",
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""]
    },
    "hyprland/workspaces": {
        // "format": "{name}: {icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "urgent": "",
            "active": "",
            "default": ""
        },
        "all-outputs": true,
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },
    "hyprland/window": {
        "separate-outputs": true
    },
    "tray": {
        "icon-size": 15,
        "spacing": 10
    },
    "custom/ibus": {
        "exec": "~/.config/waybar/scripts/ibus.sh",
        "on-click": "~/.config/hypr/scripts/ibus.sh",
        "interval": 1
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{icon} {name}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "network": {
        "format": "{ifname}: {ipaddr}/{cidr}",
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-ethernet": " {ifname}",
        "format-disconnected": "⚠ Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": " {ipaddr} via {ifname}",
        "tooltip-format-ethernet": " {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "⚠ Disconnected"
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": " {volume}%",
        "format-icons": ["", "", ""],
        "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 2.0
    },
    "clock": {
        "tooltip": false,
        "timezone": "Asia/Seoul",
        "format": "{:%Y-%m-%d %A %H:%M}"
    }
}
